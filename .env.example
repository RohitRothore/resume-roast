# groq | gemini
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Optional override. Default is a currently listed free-tier production model.
GROQ_MODEL=openai/gpt-oss-20b

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to true to skip the LLM and return a sample critique (no API key needed).
USE_MOCK_LLM=false

# Daily critiques allowed per IP
RATE_LIMIT_PER_DAY=5
